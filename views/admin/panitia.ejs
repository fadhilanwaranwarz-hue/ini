<%- include('../layout/header') %>

<div class="space-y-6">
  <!-- Header Page -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-xl font-extrabold text-slate-800 flex items-center">
        <i class="fa-solid fa-user-shield text-amber-500 mr-2"></i>
        Kelola Akun Panitia TPS
      </h1>
      <p class="text-xs text-slate-500">Buat dan kelola akun operator TPS yang bertugas memverifikasi siswa dan menerbitkan token pemilihan.</p>
    </div>
    <div class="flex items-center space-x-2">
      <button type="button" onclick="document.getElementById('modalTambahPanitia').classList.remove('hidden')"
        class="inline-flex items-center px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold rounded-xl shadow-md shadow-amber-500/20 transition">
        <i class="fa-solid fa-user-plus mr-1.5"></i>
        <span>Tambah Panitia Baru</span>
      </button>
    </div>
  </div>

  <!-- Role Info Box -->
  <div class="bg-gradient-to-r from-amber-50 via-orange-50 to-amber-100/50 rounded-2xl p-5 border border-amber-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="flex items-start space-x-3.5">
      <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold text-lg flex-shrink-0 shadow-sm">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <div>
        <h4 class="text-sm font-bold text-slate-800">Hak Akses Role PANITIA TPS</h4>
        <p class="text-xs text-slate-600 mt-0.5">
          Akun dengan role <strong>PANITIA_TPS</strong> hanya dapat memverifikasi kehadiran siswa, <strong>menambahkan pemilih baru ke DPT</strong>, menerbitkan token coblos, serta melihat live count dan berita acara. Panitia <em>tidak dapat</em> mengubah paslon atau mengubah sesi pemilihan.
        </p>
      </div>
    </div>
    <span class="px-3 py-1.5 rounded-xl bg-white border border-amber-200 text-xs font-bold text-amber-800 shadow-sm flex-shrink-0">
      <i class="fa-solid fa-users-gear mr-1 text-amber-600"></i><%= panitiaList.length %> Akun Panitia
    </span>
  </div>

  <!-- Table Container -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <h3 class="text-sm font-bold text-slate-800">Daftar Panitia TPS Aktif</h3>
      <input type="text" id="panitiaSearch" onkeyup="filterPanitiaTable()" placeholder="Cari nama atau username panitia..."
        class="w-full sm:w-64 px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-amber-500 transition">
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs" id="panitiaTable">
        <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">No</th>
            <th class="py-3 px-4">Nama Petugas</th>
            <th class="py-3 px-4">Username Login</th>
            <th class="py-3 px-4">Role Sistem</th>
            <th class="py-3 px-4">Tanggal Dibuat</th>
            <th class="py-3 px-4 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (panitiaList && panitiaList.length > 0) { %>
            <% panitiaList.forEach((p, idx) => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="py-3 px-4 text-slate-400 font-medium"><%= idx + 1 %></td>
                <td class="py-3 px-4 font-bold text-slate-800 flex items-center space-x-2.5">
                  <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xs">
                    <i class="fa-solid fa-user"></i>
                  </div>
                  <span><%= p.nama %></span>
                </td>
                <td class="py-3 px-4 font-mono font-semibold text-slate-700">@<%= p.username %></td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-700 border border-amber-200">
                    <i class="fa-solid fa-id-badge text-[9px] mr-1"></i>PANITIA TPS
                  </span>
                </td>
                <td class="py-3 px-4 text-slate-500 font-mono text-[11px]">
                  <%= new Date(p.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td class="py-3 px-4 text-center">
                  <form action="/admin/panitia/<%= p.id %>/delete" method="POST" class="inline"
                    onsubmit="return confirm('Apakah Anda yakin ingin menghapus akun panitia @<%= p.username %>? Petugas ini tidak akan dapat login lagi.')">
                    <button type="submit" title="Hapus Akun Panitia"
                      class="px-2.5 py-1 text-[11px] font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg transition flex items-center space-x-1 mx-auto">
                      <i class="fa-solid fa-trash-can"></i>
                      <span>Hapus</span>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="py-8 text-center text-slate-400 italic">
                Belum ada akun Panitia TPS yang ditambahkan. Silakan klik tombol "Tambah Panitia Baru".
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Tambah Panitia -->
<div id="modalTambahPanitia" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-md w-full overflow-hidden animate-in fade-in zoom-in-95 duration-200">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-amber-500 text-white flex items-center justify-center font-bold text-sm">
          <i class="fa-solid fa-user-plus"></i>
        </div>
        <h3 class="text-sm font-extrabold text-slate-800">Tambah Akun Panitia TPS</h3>
      </div>
      <button type="button" onclick="document.getElementById('modalTambahPanitia').classList.add('hidden')"
        class="text-slate-400 hover:text-slate-600 text-lg">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form action="/admin/panitia/add" method="POST" class="p-5 space-y-4">
      <div>
        <label for="namaPanitia" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
          Nama Lengkap Petugas <span class="text-red-500">*</span>
        </label>
        <input type="text" id="namaPanitia" name="nama" required
          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition"
          placeholder="Contoh: Bu Siti Rahmawati (Operator Meja 1)">
      </div>

      <div>
        <label for="usernamePanitia" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
          Username Login <span class="text-red-500">*</span>
        </label>
        <input type="text" id="usernamePanitia" name="username" required
          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono font-bold focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition"
          placeholder="panitia_tps1">
        <p class="text-[10px] text-slate-400 mt-1">Huruf kecil, tanpa spasi (contoh: panitia2, tps_lantai2).</p>
      </div>

      <div>
        <label for="passwordPanitia" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
          Password <span class="text-red-500">*</span>
        </label>
        <input type="password" id="passwordPanitia" name="password" required minlength="6"
          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition"
          placeholder="Minimal 6 karakter">
      </div>

      <div class="pt-3 border-t border-slate-100 flex items-center justify-end space-x-2">
        <button type="button" onclick="document.getElementById('modalTambahPanitia').classList.add('hidden')"
          class="px-4 py-2 text-xs font-bold text-slate-500 hover:text-slate-800 transition">
          Batal
        </button>
        <button type="submit"
          class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold rounded-xl shadow-md shadow-amber-500/20 transition flex items-center space-x-1.5">
          <i class="fa-solid fa-floppy-disk"></i>
          <span>Simpan Akun Panitia</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function filterPanitiaTable() {
    const query = document.getElementById('panitiaSearch').value.toLowerCase();
    const rows = document.querySelectorAll('#panitiaTable tbody tr');
    rows.forEach(r => {
      const text = r.textContent.toLowerCase();
      r.style.display = text.includes(query) ? '' : 'none';
    });
  }
</script>

<%- include('../layout/footer') %>
